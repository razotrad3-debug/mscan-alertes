# ── Copie ce fichier en ".env" et remplis les valeurs ──

# Helius (gratuit) — https://dashboard.helius.dev  -> crée une clé, colle-la ici.
# Débloque la couche wallet : distribution des holders + smart-money.
HELIUS_API_KEY=

# Telegram (optionnel) — pour recevoir les alertes façon prntwrx.
#  1. Parle à @BotFather -> /newbot -> récupère le token.
#  2. Ajoute ton bot à un chat, envoie un message, puis va sur
#     https://api.telegram.org/bot<TOKEN>/getUpdates pour lire ton chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FomoScan (optionnel) — resout les handles FOMO (@pseudo) en wallets Solana.
# Cle gratuite : https://partner.fomoscan.sh  (envoyee par Telegram)
FOMOSCAN_API_KEY=
